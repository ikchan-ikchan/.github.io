<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>弓道射形確認ツール</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #000;
    }
    #videoElement, #overlayCanvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  </style>
</head>
<body>
  <!-- カメラ映像表示用 -->
  <video id="videoElement" autoplay muted playsinline></video>
  <!-- 描画用Canvas -->
  <canvas id="overlayCanvas"></canvas>

  <!-- ml5.js CDN（PoseNet利用のため） -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ml5/0.6.0/ml5.min.js"></script>
  <script>
    // DOM要素の取得
    const video = document.getElementById('videoElement');
    const canvas = document.getElementById('overlayCanvas');
    const ctx = canvas.getContext('2d');

    // 画面サイズに合わせてCanvasサイズを調整
    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // カメラ映像を取得
    async function startVideo() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        video.srcObject = stream;
      } catch (err) {
        console.error("カメラ映像の取得に失敗しました:", err);
      }
    }
    startVideo();

    // PoseNetモデルの準備
    let poseNet;
    let poses = [];
    video.addEventListener('loadeddata', () => {
      // ml5 の PoseNet を初期化。videoを入力として利用
      poseNet = ml5.poseNet(video, { flipHorizontal: true }, () => {
        console.log('PoseNet モデルロード完了');
      });
      // ポーズ検出結果の更新
      poseNet.on('pose', results => {
        poses = results;
      });
      // アニメーションループでCanvas描画
      requestAnimationFrame(drawOverlay);
    });

    // Canvasにオーバーレイ描画
    function drawOverlay() {
      // 透明な黒でCanvas全体をクリア（動画は下にあるので透過）
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 検出結果をCanvasに描画
      poses.forEach(poseObj => {
        const pose = poseObj.pose;

        // キーポイントごとに描画（顔や各部位）
        pose.keypoints.forEach(keypoint => {
          if (keypoint.score > 0.5) { // 信頼度が0.5以上の場合のみ描画
            // キーポイントを円で描画
            const { x, y } = convertCoordinates(keypoint.position);
            ctx.beginPath();
            ctx.arc(x, y, 6, 0, 2 * Math.PI);
            ctx.fillStyle = "#ff0000";
            ctx.fill();
          }
        });

        // キーポイント間を線で結ぶ（シンプルな骨格線）
        const adjacentKeyPoints = ml5.poseNet.getAdjacentKeyPoints(pose.keypoints, 0.5);
        adjacentKeyPoints.forEach(pair => {
          const [{ position: posA }, { position: posB }] = pair;
          const a = convertCoordinates(posA);
          const b = convertCoordinates(posB);
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.lineWidth = 4;
          ctx.strokeStyle = "#00ff00";
          ctx.stroke();
        });
      });

      // 次のフレームで再描画
      requestAnimationFrame(drawOverlay);
    }

    // ビデオのサイズとCanvasのサイズが異なる場合に合わせるための座標変換
    function convertCoordinates(pos) {
      // 動画はobject-fit: cover を使用して全画面にフィットしているため、
      // 簡易的にウィンドウサイズに合わせる。
      // ※より厳密な変換を行いたい場合は、映像のアスペクト比と拡大状況に合わせた計算が必要です。
      const scaleX = window.innerWidth / video.videoWidth;
      const scaleY = window.innerHeight / video.videoHeight;
      return {
        x: pos.x * scaleX,
        y: pos.y * scaleY
      };
    }
  </script>
</body>
</html>
